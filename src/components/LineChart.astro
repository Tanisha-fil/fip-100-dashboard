---
type LineChartProps = {
  data: Array<Record<string, string | number>>;
  x: string;
  y: string;
  label: string;
  subtitle?: string;
  yLabel?: string;
};

const { data, x, y, label, subtitle, yLabel } = Astro.props as LineChartProps;

const points = data
  .map((row) => {
    const value = String(row[x]);
    return {
      x: new Date(value).getTime(),
      y: Number(row[y]),
      label: value,
    };
  })
  .filter((point) => Number.isFinite(point.x) && Number.isFinite(point.y))
  .sort((a, b) => a.x - b.x);

const payload = JSON.stringify(points);
const anchorId = label.trim().toLowerCase().replace(/\s+/g, "-");
const titleId = `${anchorId}-title`;
---

<section class="line-chart" id={anchorId} aria-labelledby={titleId}>
  <div class="chart-card">
    <div class="chart-header">
      <h2 class="chart-title" id={titleId}>
        <a href={`#${anchorId}`}>{label}</a>
      </h2>
      {subtitle ? <p class="chart-subtitle">{subtitle}</p> : null}
    </div>
    <figure class="chart-figure">
      <canvas
        role="img"
        aria-label={label}
        data-line-chart={payload}
        data-y-label={yLabel ?? ""}
      ></canvas>
    </figure>
  </div>
</section>

<style>
  .line-chart {
    --line-accent: var(--ink, #0f172a);
    margin: 0;
  }

  .chart-card {
    background: #ffffff;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 0.75rem;
    padding: 1.5rem 1.5rem 1.25rem;
    box-shadow: 0 1px 6px rgba(15, 23, 42, 0.06);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .chart-header {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .chart-title {
    margin: 0;
    font-weight: 700;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    line-height: 1.3;
  }

  .chart-title a {
    color: inherit;
    text-decoration: none;
  }

  .chart-title a:hover {
    text-decoration: underline;
  }

  .chart-subtitle {
    margin: 0;
    color: var(--muted, #475569);
    font-size: 0.78rem;
    line-height: 1.5;
  }

  .chart-figure {
    margin: 0;
  }

  .chart-figure canvas {
    display: block;
    inline-size: 100%;
    aspect-ratio: 3 / 1;
  }
</style>

<script>
  import Chart from "chart.js/auto";
  import type { ScatterDataPoint, TooltipItem } from "chart.js";
  import annotationPlugin from "chartjs-plugin-annotation";
  import "chartjs-adapter-date-fns";

  Chart.register(annotationPlugin);

  type ChartPoint = ScatterDataPoint & { label: string };

  document
    .querySelectorAll<HTMLCanvasElement>("canvas[data-line-chart]")
    .forEach((canvas) => {
      const dataset = canvas.dataset.lineChart;
      if (!dataset) return;

      const points = JSON.parse(dataset) as ChartPoint[];
      const label = canvas.ariaLabel ?? "";
      const strokeColor =
        getComputedStyle(canvas).getPropertyValue("--line-accent").trim() ||
        "#0f172a";
      const yLabel = (canvas.dataset.yLabel || "").trim();

      new Chart(canvas, {
        type: "line",
        data: {
          datasets: [
            {
              label,
              data: points,
              pointRadius: 0,
              borderColor: strokeColor,
              borderWidth: 2,
              tension: 0,
              fill: true,
              backgroundColor: "rgba(15, 23, 42, 0.04)",
            },
          ],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          animation: false,
          normalized: true,
          interaction: { mode: "index", intersect: false },
          plugins: {
            legend: { display: false },
            tooltip: {
              intersect: false,
              mode: "index",
              backgroundColor: "#0f172a",
              titleColor: "#94a3b8",
              bodyColor: "#f8fafc",
              padding: 10,
              cornerRadius: 6,
              callbacks: {
                title: ([first]: TooltipItem<"line">[]) =>
                  ((first?.raw as ChartPoint | undefined)?.label) ?? "",
              },
            },
            annotation: {
              annotations: {
                networkUpgradeV25: {
                  type: "line",
                  xMin: "2025-04-07",
                  xMax: "2025-04-07",
                  borderColor: "#d82124",
                  borderWidth: 1,
                  borderDash: [6, 6],
                  label: {
                    display: true,
                    content: "nv25",
                    rotation: 0,
                    backgroundColor: "rgba(255,255,255,0.9)",
                    color: "#d82124",
                    font: { size: 11, weight: 600 },
                    padding: { top: 2, bottom: 2, left: 4, right: 4 },
                    position: "start",
                    yAdjust: -12,
                    borderRadius: 3,
                  },
                },
              },
            },
          },
          scales: {
            x: {
              type: "time",
              time: {
                unit: "quarter",
                tooltipFormat: "PPP",
                displayFormats: { quarter: "MMM yyyy" },
              },
              grid: { display: false },
              border: { display: false },
              ticks: {
                color: "#94a3b8",
                maxRotation: 0,
                font: { size: 11 },
              },
            },
            y: {
              beginAtZero: true,
              grace: "5%",
              ticks: {
                precision: 0,
                color: "#94a3b8",
                font: { size: 11 },
              },
              border: { display: false },
              grid: { color: "rgba(15, 23, 42, 0.06)" },
              title: {
                display: Boolean(yLabel),
                text: yLabel,
                color: "#94a3b8",
                padding: { bottom: 4 },
                font: { size: 11, weight: 600 },
              },
            },
          },
        },
      });
    });
</script>
