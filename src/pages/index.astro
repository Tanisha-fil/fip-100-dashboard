---
import LineChart from "../components/LineChart.astro";
import MultiLineChart from "../components/MultiLineChart.astro";
import powerAdded from "../../public/power_added.json";
import participatingMiners from "../../public/participating_miner_count.json";
import precommitSectorBatchSize from "../../public/precommit_sector_batch_size.json";
import gasPerSectorByPath from "../../public/gas_per_sector_by_path.json";
import smallBatchCount from "../../public/small_batch_count.json";
import filReturnPerSector from "../../public/fil_return_per_sector.json";
import dailyFeeBurn from "../../public/daily_fee_burn.json";
import sectorLifetimeCost from "../../public/sector_lifetime_cost.json";
import sectorDailyFeeCost from "../../public/sector_daily_fee_cost.json";
import baseFeePercentiles from "../../public/base_fee_percentiles.json";
import gasUtilization from "../../public/gas_utilization.json";
import burnComposition from "../../public/burn_composition.json";
import circulatingSupplyVsBurn from "../../public/circulating_supply_vs_burn.json";
import sectorExtensions from "../../public/sector_extensions.json";
import renewalRate from "../../public/renewal_rate.json";

const toNumber = (value: unknown): number | null => {
	if (value === null || value === undefined || value === "") return null;
	const numeric = Number(value);
	return Number.isFinite(numeric) ? numeric : null;
};

const phaseHasObservedExpiries = (
	phaseKey: "renewal_rate_pre_pct" | "renewal_rate_during_pct" | "renewal_rate_post_pct",
) =>
	renewalRate.some(
		(row) => toNumber(row[phaseKey]) !== null && (toNumber(row.expired_count) ?? 0) > 0,
	);

const hasPreExpiries = phaseHasObservedExpiries("renewal_rate_pre_pct");
const hasDuringExpiries = phaseHasObservedExpiries("renewal_rate_during_pct");
const hasPostExpiries = phaseHasObservedExpiries("renewal_rate_post_pct");

const renewalRatePhaseLabels = [
	hasPreExpiries
		? "Renewal rate pre-grace"
		: "Renewal rate pre-grace (limited expiry observations)",
	hasDuringExpiries
		? "Renewal rate during grace"
		: "Renewal rate during grace (limited expiry observations)",
	hasPostExpiries
		? "Renewal rate post-grace"
		: "Renewal rate post-grace (limited expiry observations)",
];

const renewalRateCoverageWarnings: string[] = [];
if (!hasPreExpiries) renewalRateCoverageWarnings.push("pre-grace");
if (!hasDuringExpiries) renewalRateCoverageWarnings.push("during-grace");
if (!hasPostExpiries) renewalRateCoverageWarnings.push("post-grace");

const renewalRateSubtitleSuffix =
	renewalRateCoverageWarnings.length > 0
		? ` Caution: limited observed expiries in ${renewalRateCoverageWarnings.join(", ")} phase(s), so rates may appear saturated.`
		: "";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link
			rel="icon"
			type="image/svg+xml"
			href="/fip-100-dashboard/favicon.svg"
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&display=swap"
			rel="stylesheet"
		/>
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>FIP-100 Dashboard</title>
		<style>
			:root {
				color-scheme: light;
				--ink: #0f172a;
				--muted: #475569;
				--surface: #f1f5f9;
				--border: rgba(15, 23, 42, 0.12);
			}

			*,
			*::before,
			*::after {
				box-sizing: border-box;
			}

			body {
				margin: 0;
				background: var(--surface);
				color: var(--ink);
				font-family: "JetBrains Mono", monospace;
				line-height: 1.7;
				min-height: 100vh;
				min-height: 100svh;
				display: flex;
				flex-direction: column;
			}

			main {
				width: 100%;
				max-inline-size: 60rem;
				margin-inline: auto;
				padding-inline: 1.5rem;
				flex: 1;
				padding-block: 1.5rem 2.5rem;
				display: flex;
				flex-direction: column;
				gap: 2.5rem;
			}

				.page-header {
					display: grid;
					gap: 0.25rem 1rem;
					grid-template-columns: minmax(0, 1fr) auto;
					grid-template-areas:
						". link"
						"title title"
						"subtitle subtitle"
						"legend legend";
				align-items: start;
				background: #ffffff;
				border: 1px solid rgba(15, 23, 42, 0.08);
				border-radius: 0.75rem;
				padding: 1.5rem;
				box-shadow: 0 1px 6px rgba(15, 23, 42, 0.06);
			}

			.charts > h2.category-header {
				margin-top: 1rem;
			}

			h1 {
				margin: 0;
				font-size: clamp(2.2rem, 6vw, 3.4rem);
				text-transform: uppercase;
				letter-spacing: 0.08em;
				line-height: 1.1;
				text-wrap: balance;
			}

			.page-header h1 {
				grid-area: title;
			}

				.subtitle {
					margin: 0;
					font-size: clamp(1rem, 3vw, 1.2rem);
					color: var(--muted);
					max-inline-size: 46rem;
					text-wrap: pretty;
					grid-area: subtitle;
				}

				.timeline-legend {
					grid-area: legend;
					margin: 0;
					display: flex;
					flex-wrap: wrap;
					gap: 0.5rem 1rem;
					font-size: 0.75rem;
					color: var(--muted);
				}

				.timeline-legend span {
					display: inline-flex;
					align-items: center;
					gap: 0.35rem;
				}

				.timeline-legend span::before {
					content: "";
					display: inline-block;
					inline-size: 1.1rem;
					block-size: 0.35rem;
					border-radius: 999px;
				}

				.timeline-legend .legend-nv25::before {
					background: #d82124;
				}

				.timeline-legend .legend-nv26::before {
					background: #0f766e;
				}

				.timeline-legend .legend-grace::before {
					background: rgba(216, 33, 36, 0.18);
					border: 1px solid rgba(216, 33, 36, 0.35);
				}

			.charts {
				display: flex;
				flex-direction: column;
				gap: 1.25rem;
			}

			.category-header {
				margin: 0;
				font-size: 0.7rem;
				text-transform: uppercase;
				letter-spacing: 0.12em;
				color: var(--muted);
				display: flex;
				align-items: center;
				gap: 0.75rem;
			}

			.category-header::before {
				content: '';
				display: block;
				width: 3px;
				height: 1em;
				background: var(--ink);
				border-radius: 2px;
				flex-shrink: 0;
			}

			.category-header::after {
				content: '';
				flex: 1;
				height: 1px;
				background: var(--border);
			}

			.header-links {
				grid-area: link;
				justify-self: end;
				align-self: start;
				display: flex;
				flex-wrap: nowrap;
				align-items: center;
				gap: 0.4rem 1.25rem;
				white-space: nowrap;
				font-size: 0.8rem;
				letter-spacing: 0.04em;
				text-transform: lowercase;
				margin-bottom: 0.6rem;
			}

			.header-links a {
				color: var(--muted);
				text-decoration: none;
			}

			.header-links a:visited {
				color: var(--muted);
			}

			.header-links a:hover,
			.header-links a:focus-visible {
				color: var(--ink);
			}

			.nv25-callout {
				background: #fff;
				border: 1px solid rgba(216, 33, 36, 0.2);
				border-left: 3px solid #d82124;
				border-radius: 0.5rem;
				padding: 1rem 1.25rem;
				font-size: 0.78rem;
				line-height: 1.6;
				color: var(--muted);
			}
			.nv25-callout strong {
				color: var(--ink);
			}
			.nv25-callout a {
				color: var(--muted);
				text-decoration: underline;
				text-underline-offset: 2px;
			}
			.nv25-callout a:hover {
				color: var(--ink);
			}
		</style>
	</head>
	<body>
		<main>
			<header class="page-header">
				<h1>FIP-100 Dashboard</h1>
				<nav class="header-links" aria-label="Resources">
					<a href="https://github.com/Tanisha-fil/fip-100-dashboard"
						>[source]</a
					>
					<a
						href="https://github.com/filecoin-project/FIPs/blob/master/FIPS/fip-0100.md"
						>[fip-100]</a
					>
					<a
						href="https://github.com/filecoin-project/FIPs/discussions/1105"
						>[discussion]</a
					>
					<a
						href="https://github.com/filecoin-project/community/discussions/74"
						>[timelines]</a
					>
				</nav>
					<p class="subtitle">
						Metrics to track FIP 100 real-world network behavior
					</p>
					<p class="timeline-legend" aria-label="Upgrade timeline legend">
						<span class="legend-nv25">nv25: 2025-04-14</span>
						<span class="legend-nv26">nv26 / +90d: 2025-07-13</span>
						<span class="legend-grace">Shaded band: grace window</span>
					</p>
				</header>

			<section class="charts" aria-label="Charts">

				<!-- ── Network Overview ── -->
				<h2 class="category-header">Network Overview</h2>
				<LineChart
					data={powerAdded}
					x="date"
					y="raw_power_added"
					label="Raw Power Added (7-day avg)"
					subtitle="7-day rolling mean of daily raw byte power delta. Source: power_actor_claims"
					yLabel="PiB"
				/>
				<LineChart
					data={powerAdded}
					x="date"
					y="quality_adjusted_power_added"
					label="Quality Adjusted Power Added (7-day avg)"
					subtitle="7-day rolling mean of daily QAP delta. Source: power_actor_claims"
					yLabel="PiB (QAP)"
				/>
				<LineChart
					data={participatingMiners}
					x="date"
					y="participating_miner_count"
					label="Participating Miner Count"
					yLabel="Miners"
				/>

				<!-- ── Sector Onboarding Economics & Throughput ── -->
				<h2 class="category-header">Sector Onboarding Economics &amp; Throughput</h2>
				<div class="nv25-callout">
					<strong>nv25 (2025-04-14) — FIP-100 gas changes:</strong> Removed the batch
					balancer fee and aggregate ProveCommit fee, making batching and proof
					aggregation economically rational at all base fee levels (previously only
					viable above ~0.09 nanoFIL and ~0.065 nanoFIL base fee respectively).
					Expected per-sector gas reductions: ~3.6&times; for batched PreCommit,
					~2&times; for aggregated ProveCommit. Hard protocol batch-size caps were
					also lifted. <a href="https://github.com/filecoin-project/FIPs/blob/master/FIPS/fip-0100.md" target="_blank" rel="noopener">[fip-100 spec &#x2197;]</a>
					<a href="https://github.com/filecoin-project/FIPs/discussions/1105" target="_blank" rel="noopener">[discussion &#x2197;]</a>
				</div>
				<MultiLineChart
					data={precommitSectorBatchSize}
					x="date"
					ys={["avg_sectors_per_message", "median_sectors_per_message"]}
					labels={["Mean batch size", "Median batch size"]}
					title="PreCommitSectorBatch2 Batch Size (Mean & Median)"
					subtitle="Source: PreCommitSectorBatch2 messages"
					yLabel="Sectors"
				/>
				<MultiLineChart
					data={precommitSectorBatchSize}
					x="date"
					ys={["messages", "aggregate_messages"]}
					labels={["PreCommitSectorBatch2 messages", "ProveCommitAggregate messages"]}
					title="Daily Batch & Aggregate Message Count"
					subtitle="PreCommitSectorBatch2 = sector batching; ProveCommitAggregate = proof aggregation (distinct mechanisms). Source: parsed_messages"
					yLabel="Messages"
				/>
					<MultiLineChart
						data={precommitSectorBatchSize}
						x="date"
						ys={["avg_aggregate_size", "median_aggregate_size"]}
						labels={["Mean proof-aggregation size", "Median proof-aggregation size"]}
						title="ProveCommitAggregate Size (Mean & Median)"
						subtitle="ProveCommitAggregate is rarely used (~30 days of data); most miners use ProveCommitSectors3 instead. Source: parsed_messages"
						yLabel="Sectors"
						noDataMessage="ProveCommitAggregate messages are present, but aggregate-size values are unavailable in current source data. See 'Daily Batch & Aggregate Message Count' above for usage."
					/>
				<MultiLineChart
					data={gasPerSectorByPath}
					x="date"
					ys={["PreCommitSectorBatch2", "ProveCommitSectors3", "ProveCommitAggregate", "ProveReplicaUpdates3"]}
					labels={["PreCommitSectorBatch2", "ProveCommitSectors3", "ProveCommitAggregate", "ProveReplicaUpdates3"]}
					title="Avg Gas per Sector by Onboarding Path"
					subtitle="Only PreCommitSectorBatch2 has sufficient data in Lily; ProveCommitSectors3/Aggregate/ReplicaUpdates3 columns are sparse or empty. Source: derived_gas_outputs joined with parsed_messages"
					yLabel="nanoFIL"
				/>
				<LineChart
					data={smallBatchCount}
					x="date"
					y="fuller_batch_pct"
					label="Fuller Batch % (>= 4 sectors)"
					subtitle="% of PreCommitSectorBatch2 messages at or above break-even batch size (>= 4 sectors). Higher = more efficient onboarding."
					yLabel="%"
				/>
				<LineChart
					data={filReturnPerSector}
					x="date"
					y="fil_return_per_sector"
					label="FIL Block Reward Return per New Sector"
					subtitle="Approximation: daily block rewards / daily sectors added"
					yLabel="FIL / sector"
				/>

				<!-- ── Daily-Fee Burden ── -->
				<h2 class="category-header">Daily-Fee Burden</h2>
				<MultiLineChart
					data={dailyFeeBurn}
					x="date"
					ys={["total_fee_burn_fil", "sector_onboarding_gas_fil"]}
					labels={["Total Gas Burn", "Sector Onboarding Gas Burn"]}
					title="Daily Gas Fee Burn"
					subtitle="Gas burn from all messages vs sector onboarding messages only. Note: the FIP-100 DailyFee is deducted from vesting rewards by the cron actor and is not captured here. Source: derived_gas_outputs"
					yLabel="FIL"
				/>
				<MultiLineChart
					data={sectorLifetimeCost}
					x="date"
					ys={["large_sp", "medium_sp", "small_sp"]}
					labels={["Large SP (>=10 sectors/batch)", "Medium SP (4-9 sectors/batch)", "Small SP (1-3 sectors/batch)"]}
					title="Avg Per-Sector Onboarding Gas Cost by SP Archetype"
					subtitle="PreCommit + ProveCommit gas cost per sector, split by batch size as SP archetype proxy. Gas-only; excludes FIP-100 DailyFee (see chart below). Source: derived_gas_outputs"
					yLabel="nanoFIL"
				/>
				<LineChart
					data={sectorDailyFeeCost}
					x="date"
					y="avg_daily_fee_lifetime_cost_nanofil"
					label="Avg Per-Sector Projected DailyFee Cost (nv25+)"
					subtitle="Post-nv25 only. Extrapolated from daily_fee × declared sector lifetime; actual cost depends on early termination or extension. Source: miner_sector_infos_v7"
					yLabel="nanoFIL"
				/>

				<!-- ── Base-Fee & Blockspace Health ── -->
				<h2 class="category-header">Base-Fee &amp; Blockspace Health</h2>
				<MultiLineChart
					data={baseFeePercentiles}
					x="date"
					ys={["base_fee_p50_nanofil", "base_fee_p95_nanofil"]}
					labels={["p50 Base Fee", "p95 Base Fee"]}
					title="Daily Base Fee Percentiles"
					subtitle="Source: block_headers.parent_base_fee"
					yLabel="nanoFIL"
				/>
				<LineChart
					data={gasUtilization}
					x="date"
					y="gas_utilization_pct"
					label="Daily Gas Utilization Rate"
					subtitle="sum(gas_used) / sum(gas_limit) per day"
					yLabel="%"
				/>
				<LineChart
					data={gasUtilization}
					x="date"
					y="theoretical_max_sectors_per_day"
					label="Theoretical Max Sector Onboarding Rate"
					subtitle="Network gas capacity (10B gas/tipset x 2880 tipsets/day) / avg gas used per PreCommitSectorBatch2 sector. Upper bound if all blockspace were used for onboarding."
					yLabel="Sectors / day"
				/>

				<!-- ── Network Burn & Token-Economics ── -->
				<h2 class="category-header">Network Burn &amp; Token-Economics</h2>
				<MultiLineChart
					data={burnComposition}
					x="date"
					ys={["dispute_termination_gas_fil", "sector_onboarding_gas_fil", "other_burn_fil"]}
					labels={["Dispute/Termination Gas", "Sector Onboarding Gas", "Other Gas"]}
					title="Daily Gas Burn Composition"
					subtitle="Gas costs by message category. Dispute/Termination = DisputeWindowedPoSt + TerminateSectors gas only (not the FIL slash amounts). Source: derived_gas_outputs"
					yLabel="FIL"
				/>
				<MultiLineChart
					data={circulatingSupplyVsBurn}
					x="date"
					ys={["circulating_fil", "burnt_fil"]}
					labels={["Circulating FIL", "Burnt FIL"]}
					title="Circulating Supply vs Cumulative Burn"
					subtitle="Absolute FIL values. Source: chain_economics"
					yLabel="FIL"
				/>
				<MultiLineChart
					data={circulatingSupplyVsBurn}
					x="date"
					ys={["circulating_growth_pct", "daily_burn_rate_pct"]}
					labels={["Circulating supply growth %", "Daily burn rate % of supply"]}
					title="Circulating Supply Growth vs Fee Burn Rate (%)"
					subtitle="Day-over-day % change in circulating supply vs daily new burn as % of circulating supply. Source: chain_economics"
					yLabel="%"
				/>

				<!-- ── Grace-Period Behaviour ── -->
				<h2 class="category-header">Grace-Period Behaviour</h2>
				<MultiLineChart
					data={sectorExtensions}
					x="date"
					ys={["extensions_pre_grace", "extensions_during_grace", "extensions_post_grace", "baseline_rolling_30d"]}
					labels={["Pre-grace", "During grace (nv25 to +90d)", "Post-grace", "30-Day Rolling Avg"]}
					title="Sector Extensions per Day by Grace-Period Phase"
					subtitle="nv25 ~2025-04-14; grace window ends ~2025-07-13. Individual SECTOR_EXTENDED events. Source: miner_sector_events"
					yLabel="Extensions"
				/>
				<MultiLineChart
					data={renewalRate}
					x="date"
					ys={["expired_count", "extended_count"]}
					labels={["Expired", "Extended"]}
					title="Sector Expiry vs Extension Count"
					subtitle="Source: miner_sector_events"
					yLabel="Sectors"
				/>
					<MultiLineChart
						data={renewalRate}
						x="date"
						ys={["renewal_rate_pre_pct", "renewal_rate_during_pct", "renewal_rate_post_pct"]}
						labels={renewalRatePhaseLabels}
						title="Sector Renewal Rate by Grace-Period Phase"
						subtitle={`Cohort-based: renewed / (renewed + expired) by scheduled expiry date, segmented by grace window. 7-day rolling avg. Source: miner_sector_events.${renewalRateSubtitleSuffix}`}
						yLabel="%"
					/>

			</section>
		</main>
	</body>
</html>
